figure; 
plot(time_vec, ref_signal, 'r--', 'LineWidth', 2); 
hold on; 
plot(time_vec, y_out, 'b-', 'LineWidth', 2); 
grid on; 
title('FPGA-in-the-Loop Motor Control Simulation'); 
xlabel('Time (s)'); 
ylabel('Motor Output'); 
