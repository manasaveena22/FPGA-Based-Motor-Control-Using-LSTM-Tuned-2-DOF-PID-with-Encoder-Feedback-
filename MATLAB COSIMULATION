clear; clc; close all; 
T_step = 0.001;           
T_final = 2 
N_steps = T_final / T_step; 
P_motor = 1 / (s * (0.01*s + 0.1));  
P_motor_d = c2d(P_motor, T_step, 'zoh');  
vivado_sim_path = 'C:/Xilinx/Vivado/2023.1/main_project/co_sim_mat/co_sim_mat.sim'; 
vivado_cmd = 'xsim motor_control_cosim_tb_behav -R'; 
q_format = 8; 
scale_factor = 2^q_format; 
time_vec = (0:N_steps-1) * T_step; 
ref_signal = 10 * ones(1, N_steps);  
ref_signal(1:1/T_step) = 0;    
y_out = zeros(1, N_steps);  
u_out = zeros(1, N_steps);  
plant_states = [0; 0];      
fprintf('Starting Co-Simulation...\n'); 
current_dir = pwd;  
for k = 1:N_steps 
r_k = ref_signal(k); 
y_k = y_out(k); 
r_k_fixed = round(r_k * scale_factor); 
y_k_fixed = round(y_k * scale_factor); 
file_id = fopen(fullfile(vivado_sim_path, 'input.txt'), 'w'); 
fprintf(file_id, '%d %d', r_k_fixed, y_k_fixed); 
fclose(file_id); 
cd(vivado_sim_path); 
[status, cmdout] = system(vivado_cmd); 
cd(current_dir);     
if status ~= 0 
fprintf('Error during Vivado simulation at step %d.\n', k); 
disp(cmdout); 
break; 
end 
file_id = fopen(fullfile(vivado_sim_path, 'output.txt'), 'r'); 
u_k_fixed = fscanf(file_id, '%d'); 
fclose(file_id); 
u_k = double(u_k_fixed) / scale_factor; 
u_out(k) = u_k; 
if k < N_steps 
% Using lsim to simulate one step 
[y_next, ~, plant_states] = lsim(P_motor_d, u_k, [0, T_step], plant_states); 
y_out(k+1) = y_next(end); 
end 
if mod(k, 10) == 0 
fprintf('Simulation Step %d / %d Complete.\n', k, N_steps); 
53 
end 
end 
