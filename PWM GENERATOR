module pwm_generator ( 
input wire clk, rst_n, en, 
    input wire signed [15:0] u_k, 
    output reg pwm_out 
); 
    parameter integer PWM_PERIOD = 16'd5000; 
    reg [15:0] counter, threshold; 
    always @(posedge clk or negedge rst_n) begin 
        if (!rst_n) {counter, pwm_out, threshold} <= 33'd0; 
        else if (en) begin 
               threshold <= (^u_k === 1'bx) ? 16'd0 : (u_k >= 16'sd65280) ? PWM_PERIOD : 
(u_k * PWM_PERIOD) >>> 8; 
            counter <= (counter >= PWM_PERIOD - 1) ? 16'd0 : counter + 1; 
            pwm_out <= (counter < threshold); 
        end 
    end 
endmodule
